# このファイルを terraform.tfvars にコピーして値を埋める:
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars は .gitignore 済み（秘密情報を含むためコミットしない）

# 必須: イメージの名前空間（Docker Hubの個人アカウントではユーザー名と同じ）
image_namespace = "your-dockerhub-username"

# 必須: レジストリの認証情報
# Docker HubのPersonal Access Token（read権限で足りる）
registry_username = "your-dockerhub-username"
registry_password = "dckr_pat_..."

# トークンをローテーションするときは、値を変えるだけでなく
# registry_password_version も現在の値より大きくすること(write-only属性は
# 値ではなくこのバージョン番号の変化で更新を検知するため)。
# 現在のデフォルトは 2 なので、次のローテーションでは 3 を指定する。
# registry_password_version = 3

# 任意
# イメージ参照のプレフィックスと、AppRunが認証に使うホスト名は別物。
# Docker Hubではそれぞれ docker.io と index.docker.io で、
# server に docker.io を送るとAPIが400 Validation Errorを返す。
# image_registry_host   = "docker.io"
# image_registry_server = "index.docker.io"
# image_repository      = "nuance-mapper"
# zone                  = "is1b"
# max_cpu               = "0.5"
# max_memory            = "1Gi"
# max_scale             = 2
# AppRun secretのローテーション版。機密値自体はtfvarsへ書かず、
# .github/scripts/apprun-secrets.shへ環境変数で渡す。
# app_secret_version    = "1"

# デプロイするイメージ。タグまたは digest を指定する。
# タグは必ず一意にすること（同じタグを上書きしても新しいバージョンは作られない）。
# image_tag = "a4eb065"
# image_tag = "sha256:3d78fd00a7c78463a7128d23a869264d62a9192378033368fd2657ac4d4bae9d"
